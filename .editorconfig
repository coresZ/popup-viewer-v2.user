# EditorConfig 帮助统一不同编辑器/IDE 的编码与缩进风格
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.css]
indent_style = space
indent_size = 2

[*.{js,mjs,json,yml,yaml,html}]
indent_style = space
indent_size = 2
